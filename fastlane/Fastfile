# xcodebuild prints its dependency graph with a "\u279c" in every line, and does so whenever the
# graph has been recomputed — after the project is regenerated, which this lane does every run.
# Under a C locale xcpretty reads that byte as US-ASCII and dies, `set -o pipefail` turns the dead
# formatter into a failed build, and the truncated log shows a build that simply stopped. It cost
# an afternoon to find once. Both variables are needed: Ruby reads LANG, and LC_ALL overrides an
# LC_CTYPE inherited from the shell.
ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?

# Lanes are the single definition of "does this build". CI calls the same ones a developer does,
# so a green pipeline and a green machine cannot mean different things.

require "json"
require "shellwords"
require "timeout"
require "tmpdir"
require "fileutils"

default_platform(:ios)

DEMO_PROJECT = "Demo/RenderBenchDemo.xcodeproj"
DEMO_SCHEME = "RenderBenchDemo"
# Measured on this machine, 14 September 2026: the whole test action — build, 87 unit tests and 4
# UI tests — takes about 190 s. Five times that is still far below the three hours a starved run
# has actually stood for.
DEMO_TEST_CAP_SECONDS = Integer(ENV.fetch("RENDERBENCH_DEMO_TEST_CAP", "900"))

platform :ios do
  desc "Stamp the build with the revision it came from"
  lane :stamp do
    sha = sh("git", "-C", "..", "rev-parse", "HEAD", log: false).strip
    # BuildInfo.swift is excluded from the check because stamping it is what makes the tree
    # differ. Counting our own stamp as a modification would make gitDirty permanently true and
    # so tell a reader nothing.
    dirty = !sh(
      "git", "-C", "..", "status", "--porcelain",
      "--", ".", ":(exclude)Demo/Sources/BuildInfo.swift",
      log: false
    ).strip.empty?
    swift = sh("swift", "--version", log: false)[/Apple Swift version ([\d.]+)/, 1] || "unknown"
    xcode = sh("xcodebuild", "-version", log: false)[/Xcode ([\d.]+)/, 1]

    # The committed placeholder is unusable on purpose: bench-guard rejects a gitSha of "unknown",
    # so a measurement from an unstamped build cannot be filed as evidence.
    File.write("../Demo/Sources/BuildInfo.swift", <<~SWIFT)
      /// Facts about the build that only the build itself can know.
      ///
      /// Generated by `fastlane stamp`. Do not edit: the committed values are placeholders, and
      /// bench-guard rejects a result whose `gitSha` is `unknown`, so a measurement taken from a
      /// build that skipped the stamp cannot be filed as evidence.
      enum BuildInfo {
          static let gitSha = "#{sha}"
          static let gitDirty = #{dirty}
          static let swiftVersion = "#{swift}"
          static let xcodeVersion: String? = #{xcode ? "\"#{xcode}\"" : "nil"}
      }
    SWIFT
    UI.message("stamped #{sha[0, 12]}#{dirty ? ' (dirty)' : ''}")
  end

  desc "Validate the benchmark schema, the example and every stored result"
  lane :bench_guard do
    sh("swift", "run", "--package-path", "..", "CheckBenchmarkResults", File.expand_path("..", Dir.pwd))
    guard_rejects_what_it_must

    # A stamped BuildInfo.swift in the repository would attribute every later build to one old
    # revision, and every result taken from those builds to the wrong commit. Cheap to check, and
    # the failure it prevents is invisible in the data.
    committed = sh("git", "-C", "..", "show", "HEAD:Demo/Sources/BuildInfo.swift", log: false)
    unless committed.include?('gitSha = "unknown"')
      UI.user_error!(
        "Demo/Sources/BuildInfo.swift is committed with a real revision. The committed copy must " \
        "hold placeholders; `fastlane stamp` fills it in locally."
      )
    end
  end


  # The gate that guards the gate.
  #
  # bench-guard decides what counts as evidence in this repository, and until now it was checked by
  # hand — which means it was checked once, on a tree where it happened to pass. Each case below
  # copies Benchmarks/ to a scratch root, breaks exactly one thing a reader would be misled by, and
  # requires a refusal. The first case breaks nothing: a harness that cannot pass proves nothing
  # about the failures it reports.
  def guard_rejects_what_it_must
    root = File.expand_path("..", Dir.pwd)
    stored = Dir[File.join(root, "Benchmarks/results/*.json")].reject { |f| f.end_with?(".gitkeep") }
    UI.user_error!("no stored result to build fixtures from") if stored.empty?

    cases = {
      "an untouched copy" => [true, ->(_b) {}],
      "a run measured on a simulator" => [false, ->(b) { edit_result(b) { |r| r["env"]["isSimulator"] = true } }],
      "a build that skipped the stamp" => [false, ->(b) { edit_result(b) { |r| r["run"]["gitSha"] = "unknown" } }],
      "a case whose equivalence failed" => [false, ->(b) { edit_result(b) { |r| r["cases"][0]["equivalence"] = "failed" } }],
      "a schema that stopped requiring gitSha" => [false, ->(b) {
        edit_json(File.join(b, "schema.json")) { |s| s["properties"]["run"]["required"].delete("gitSha") }
      }],
      "an example that could pass for a measurement" => [false, ->(b) {
        edit_json(File.join(b, "example.json")) { |e| e["run"]["id"] = "run-0001" }
      }]
    }

    cases.each do |name, (must_pass, break_it)|
      Dir.mktmpdir do |scratch|
        FileUtils.cp_r(File.join(root, "Benchmarks"), scratch)
        break_it.call(File.join(scratch, "Benchmarks"))
        passed = system(
          "swift", "run", "--package-path", "..", "CheckBenchmarkResults", scratch,
          out: File::NULL, err: File::NULL
        )
        if passed == must_pass
          UI.message("bench-guard #{must_pass ? "accepts" : "rejects"}: #{name}")
        else
          UI.user_error!(
            "bench-guard #{passed ? "accepted" : "rejected"} #{name}; it must have " \
            "#{must_pass ? "accepted" : "rejected"} it. The guard is not measuring what it claims."
          )
        end
      end
    end

    # `--write-example` regenerates the file a reader copies from. Nothing checked that what it
    # writes still passes the guard that reads it, which is the one property it must have.
    Dir.mktmpdir do |scratch|
      FileUtils.cp_r(File.join(root, "Benchmarks"), scratch)
      File.delete(File.join(scratch, "Benchmarks/example.json"))
      sh("swift", "run", "--package-path", "..", "CheckBenchmarkResults", scratch, "--write-example")
      UI.user_error!("--write-example wrote no example") unless File.exist?(File.join(scratch, "Benchmarks/example.json"))
      sh("swift", "run", "--package-path", "..", "CheckBenchmarkResults", scratch)
      UI.message("bench-guard accepts: the example its own --write-example regenerates")
    end
  end

  # Applies a change to the one stored result in a scratch Benchmarks/ directory.
  def edit_result(benchmarks, &block)
    file = Dir[File.join(benchmarks, "results/*.json")].reject { |f| f.end_with?(".gitkeep") }.first
    edit_json(file, &block)
  end

  def edit_json(path)
    parsed = JSON.parse(File.read(path))
    yield parsed
    File.write(path, JSON.pretty_generate(parsed))
  end

  desc "Regenerate the demo project from Demo/project.yml"
  lane :generate do
    Dir.chdir("../Demo") { sh("xcodegen", "generate") }
  end

  desc "Build and test the package on the host — the fastest failure signal available"
  lane :package do
    sh("swift", "build", "--package-path", "..")
    sh("swift", "test", "--package-path", "..")
  end

  desc "Check the layering rule. Nothing else enforces it: SwiftPM does not restrict imports."
  lane :imports do
    sh("swift", "run", "--package-path", "..", "CheckImports", File.expand_path("..", Dir.pwd))
  end

  desc "Check that the method pages still describe symbols that exist"
  lane :method_docs do
    sh("swift", "run", "--package-path", "..", "CheckMethodDocs", File.expand_path("..", Dir.pwd))
  end

  desc "Build the demo for a simulator"
  lane :demo do
    stamp
    generate
    xcodebuild(
      project: DEMO_PROJECT,
      scheme: DEMO_SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      build: true,
      derivedDataPath: "Demo/.build-demo"
    )
  end

  desc "Run the demo scheme's test action on a simulator"
  lane :demo_tests do
    stamp
    generate

    # The scheme's test action, not a named target: a future test target can join the scheme
    # without this lane having to learn its name.
    devices_by_runtime = JSON.parse(
      sh("xcrun", "simctl", "list", "devices", "available", "-j", log: false)
    )["devices"]
    # Newest runtime first. `simctl` lists runtimes in installation order, not version order, and
    # an older one left installed for another project would otherwise win — one that cannot run a
    # build with this project's deployment target at all.
    device_name = devices_by_runtime.sort.reverse
      .flat_map { |_runtime, devices| devices }
      .find { |device| device["name"].include?("iPhone") }
      &.fetch("name")
    UI.user_error!("no iPhone simulator available") unless device_name

    # A result bundle, and a summary read back out of it. `xcpretty` does not understand
    # swift-testing's output: the 83 tests of RenderBenchDemoTests run and pass, and not one line
    # of them reaches the lane's log — a failure there would show only as a non-zero exit status,
    # with no test named. The bundle also lands under the shared derived data path, which is where
    # the workflow's export step already looks for it.
    bundle = File.expand_path("../Demo/.build-demo/demo-tests.xcresult", Dir.pwd)
    FileUtils.rm_rf(bundle)

    # Run xcodebuild ourselves so the cap below can actually reach it. Ruby's Timeout raises into
    # the main thread, and the main thread inside fastlane's own xcodebuild action does not come
    # back until the child does: with a 25 s cap a 145 s run was "stopped" after 145 s. A cap that
    # fires only once the thing it was capping has finished is not a cap, and measured on 14
    # September 2026 that is exactly what it did. The watchdog kills the process group by pid.
    elapsed = nil
    log = File.expand_path("../Demo/.build-demo/demo-tests.log", Dir.pwd)
    FileUtils.mkdir_p(File.dirname(log))

    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    timed_out = false
    begin
      pid = Process.spawn(
        "xcodebuild",
        "-project", File.expand_path("../#{DEMO_PROJECT}", Dir.pwd),
        "-scheme", DEMO_SCHEME,
        "-destination", "platform=iOS Simulator,name=#{device_name}",
        "-derivedDataPath", File.expand_path("../Demo/.build-demo", Dir.pwd),
        "-resultBundlePath", bundle,
        "test",
        out: log, err: [:child, :out], pgroup: true
      )
      group = Process.getpgid(pid)

      watchdog = Thread.new do
        # A deadline, not a sleep: a spurious wake-up must not shorten the cap.
        deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + DEMO_TEST_CAP_SECONDS
        while Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
          sleep 2
          break unless begin
            Process.kill(0, pid)
            true
          rescue Errno::ESRCH
            false
          end
        end
        begin
          timed_out = true
          Process.kill("TERM", -group)
          sleep 5
          Process.kill("KILL", -group)
        rescue Errno::ESRCH
          nil
        end
      end

      _, status = Process.waitpid2(pid)
      watchdog.kill
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started

      if timed_out
        UI.user_error!(
          format(
            "the demo test action was killed after %.0f s, past the %d s cap. This says nothing " \
            "about the code: check host load and whether an earlier run left a simulator behind, " \
            "then run the lane again. Output: %s",
            elapsed, DEMO_TEST_CAP_SECONDS, log
          )
        )
      end
      unless status.success?
        # Raised here and not left to the summary: a build that never reached the tests writes no
        # failures into the bundle, and a lane that only reports what the bundle holds would call
        # that green. Running xcodebuild directly means nothing else turns a non-zero status into
        # a red lane — verified by breaking one test on purpose and watching this lane pass.
        UI.error(File.readlines(log).last(40).join) if File.exist?(log)
        report_test_results(bundle) if File.exist?(bundle)
        UI.user_error!("the demo test action exited #{status.exitstatus}; see #{log}")
      end
    ensure
      elapsed ||= Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
      UI.message(format("demo test action: %.0f s of a %d s cap", elapsed, DEMO_TEST_CAP_SECONDS))
      report_test_results(bundle) if File.exist?(bundle) && !timed_out
    end
  end

  desc "Build the demo, install it on a booted simulator and launch it"
  lane :run_demo do
    demo
    udid = sh("xcrun", "simctl", "list", "devices", "booted", "-j", log: false)
    UI.user_error!("no booted simulator — run `xcrun simctl boot <device>` first") unless udid.include?("Booted")
    app = "Demo/.build-demo/Build/Products/Debug-iphonesimulator/#{DEMO_SCHEME}.app"
    Dir.chdir("..") do
      sh("xcrun", "simctl", "install", "booted", app)
      # Read out of the bundle that was just installed, never written down here. A literal drifted
      # from the project once already and the lane went on reporting success, because a stale build
      # under the old identifier was still installed on this machine — so it launched that instead.
      bundle_id = sh(
        "/usr/libexec/PlistBuddy", "-c", "Print :CFBundleIdentifier", "#{app}/Info.plist", log: false
      ).strip
      UI.user_error!("the built app declares no bundle identifier") if bundle_id.empty?
      sh("xcrun", "simctl", "launch", "booted", bundle_id)
    end
  end


  # Reads the run back out of the result bundle and says what actually happened.
  #
  # Required because a formatter that silently drops a whole test library is worse than no
  # formatter: the lane stays green-looking while the tests it claims to run are invisible. Zero
  # tests is treated as a failure for the same reason the mutation harness treats it that way — a
  # check that cannot have failed did not pass.
  def report_test_results(bundle)
    unless File.exist?(bundle)
      UI.user_error!("no result bundle at #{bundle}: the test action did not get far enough to write one")
    end

    summary = JSON.parse(
      sh("xcrun", "xcresulttool", "get", "test-results", "summary", "--path", bundle, "--compact",
         log: false)
    )
    total = summary["totalTestCount"].to_i
    failed = summary["failedTests"].to_i

    UI.message(
      "demo tests: #{total} run, #{summary["passedTests"]} passed, #{failed} failed, " \
      "#{summary["skippedTests"]} skipped"
    )
    Array(summary["testFailures"]).each do |failure|
      UI.error("  FAILED #{failure["testName"]} — #{failure["failureText"]}")
    end

    UI.user_error!("the test action reported 0 tests; a run that cannot fail did not pass") if total.zero?
    UI.user_error!("#{failed} demo test#{failed == 1 ? "" : "s"} failed") if failed.positive?
  end

  desc "Everything CI runs"
  lane :ci do
    package
    imports
    method_docs
    bench_guard
    demo
    demo_tests
  end
end
