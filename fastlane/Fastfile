# xcodebuild prints its dependency graph with a "\u279c" in every line, and does so whenever the
# graph has been recomputed — after the project is regenerated, which this lane does every run.
# Under a C locale xcpretty reads that byte as US-ASCII and dies, `set -o pipefail` turns the dead
# formatter into a failed build, and the truncated log shows a build that simply stopped. It cost
# an afternoon to find once. Both variables are needed: Ruby reads LANG, and LC_ALL overrides an
# LC_CTYPE inherited from the shell.
ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?

# Lanes are the single definition of "does this build". CI calls the same ones a developer does,
# so a green pipeline and a green machine cannot mean different things.

require "json"
require "shellwords"

default_platform(:ios)

DEMO_PROJECT = "Demo/RenderBenchDemo.xcodeproj"
DEMO_SCHEME = "RenderBenchDemo"

platform :ios do
  desc "Stamp the build with the revision it came from"
  lane :stamp do
    sha = sh("git", "-C", "..", "rev-parse", "HEAD", log: false).strip
    # BuildInfo.swift is excluded from the check because stamping it is what makes the tree
    # differ. Counting our own stamp as a modification would make gitDirty permanently true and
    # so tell a reader nothing.
    dirty = !sh(
      "git", "-C", "..", "status", "--porcelain",
      "--", ".", ":(exclude)Demo/Sources/BuildInfo.swift",
      log: false
    ).strip.empty?
    swift = sh("swift", "--version", log: false)[/Apple Swift version ([\d.]+)/, 1] || "unknown"
    xcode = sh("xcodebuild", "-version", log: false)[/Xcode ([\d.]+)/, 1]

    # The committed placeholder is unusable on purpose: bench-guard rejects a gitSha of "unknown",
    # so a measurement from an unstamped build cannot be filed as evidence.
    File.write("../Demo/Sources/BuildInfo.swift", <<~SWIFT)
      /// Facts about the build that only the build itself can know.
      ///
      /// Generated by `fastlane stamp`. Do not edit: the committed values are placeholders, and
      /// bench-guard rejects a result whose `gitSha` is `unknown`, so a measurement taken from a
      /// build that skipped the stamp cannot be filed as evidence.
      enum BuildInfo {
          static let gitSha = "#{sha}"
          static let gitDirty = #{dirty}
          static let swiftVersion = "#{swift}"
          static let xcodeVersion: String? = #{xcode ? "\"#{xcode}\"" : "nil"}
      }
    SWIFT
    UI.message("stamped #{sha[0, 12]}#{dirty ? ' (dirty)' : ''}")
  end

  desc "Validate the benchmark schema, the example and every stored result"
  lane :bench_guard do
    sh("swift", "run", "--package-path", "..", "CheckBenchmarkResults", File.expand_path("..", Dir.pwd))

    # A stamped BuildInfo.swift in the repository would attribute every later build to one old
    # revision, and every result taken from those builds to the wrong commit. Cheap to check, and
    # the failure it prevents is invisible in the data.
    committed = sh("git", "-C", "..", "show", "HEAD:Demo/Sources/BuildInfo.swift", log: false)
    unless committed.include?('gitSha = "unknown"')
      UI.user_error!(
        "Demo/Sources/BuildInfo.swift is committed with a real revision. The committed copy must " \
        "hold placeholders; `fastlane stamp` fills it in locally."
      )
    end
  end

  desc "Regenerate the demo project from Demo/project.yml"
  lane :generate do
    Dir.chdir("../Demo") { sh("xcodegen", "generate") }
  end

  desc "Build and test the package on the host — the fastest failure signal available"
  lane :package do
    sh("swift", "build", "--package-path", "..")
    sh("swift", "test", "--package-path", "..")
  end

  desc "Check the layering rule. Nothing else enforces it: SwiftPM does not restrict imports."
  lane :imports do
    sh("swift", "run", "--package-path", "..", "CheckImports", File.expand_path("..", Dir.pwd))
  end

  desc "Check that the method pages still describe symbols that exist"
  lane :method_docs do
    sh("swift", "run", "--package-path", "..", "CheckMethodDocs", File.expand_path("..", Dir.pwd))
  end

  desc "Build the demo for a simulator"
  lane :demo do
    stamp
    generate
    xcodebuild(
      project: DEMO_PROJECT,
      scheme: DEMO_SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      build: true,
      derivedDataPath: "Demo/.build-demo"
    )
  end

  desc "Run the demo scheme's test action on a simulator"
  lane :demo_tests do
    stamp
    generate

    # The scheme's test action, not a named target: a future test target can join the scheme
    # without this lane having to learn its name.
    devices_by_runtime = JSON.parse(
      sh("xcrun", "simctl", "list", "devices", "available", "-j", log: false)
    )["devices"]
    # Newest runtime first. `simctl` lists runtimes in installation order, not version order, and
    # an older one left installed for another project would otherwise win — one that cannot run a
    # build with this project's deployment target at all.
    device_name = devices_by_runtime.sort.reverse
      .flat_map { |_runtime, devices| devices }
      .find { |device| device["name"].include?("iPhone") }
      &.fetch("name")
    UI.user_error!("no iPhone simulator available") unless device_name

    # A result bundle, and a summary read back out of it. `xcpretty` does not understand
    # swift-testing's output: the 83 tests of RenderBenchDemoTests run and pass, and not one line
    # of them reaches the lane's log — a failure there would show only as a non-zero exit status,
    # with no test named. The bundle also lands under the shared derived data path, which is where
    # the workflow's export step already looks for it.
    bundle = File.expand_path("../Demo/.build-demo/demo-tests.xcresult", Dir.pwd)
    FileUtils.rm_rf(bundle)

    begin
      xcodebuild(
        project: DEMO_PROJECT,
        scheme: DEMO_SCHEME,
        destination: "platform=iOS Simulator,name=#{device_name}",
        derivedDataPath: "Demo/.build-demo",
        test: true,
        xcargs: "-resultBundlePath #{bundle.shellescape}"
      )
    ensure
      report_test_results(bundle)
    end
  end

  desc "Build the demo, install it on a booted simulator and launch it"
  lane :run_demo do
    demo
    udid = sh("xcrun", "simctl", "list", "devices", "booted", "-j", log: false)
    UI.user_error!("no booted simulator — run `xcrun simctl boot <device>` first") unless udid.include?("Booted")
    app = "Demo/.build-demo/Build/Products/Debug-iphonesimulator/#{DEMO_SCHEME}.app"
    Dir.chdir("..") do
      sh("xcrun", "simctl", "install", "booted", app)
      sh("xcrun", "simctl", "launch", "booted", "dev.renderbench.demo")
    end
  end


  # Reads the run back out of the result bundle and says what actually happened.
  #
  # Required because a formatter that silently drops a whole test library is worse than no
  # formatter: the lane stays green-looking while the tests it claims to run are invisible. Zero
  # tests is treated as a failure for the same reason the mutation harness treats it that way — a
  # check that cannot have failed did not pass.
  def report_test_results(bundle)
    unless File.exist?(bundle)
      UI.user_error!("no result bundle at #{bundle}: the test action did not get far enough to write one")
    end

    summary = JSON.parse(
      sh("xcrun", "xcresulttool", "get", "test-results", "summary", "--path", bundle, "--compact",
         log: false)
    )
    total = summary["totalTestCount"].to_i
    failed = summary["failedTests"].to_i

    UI.message(
      "demo tests: #{total} run, #{summary["passedTests"]} passed, #{failed} failed, " \
      "#{summary["skippedTests"]} skipped"
    )
    Array(summary["testFailures"]).each do |failure|
      UI.error("  FAILED #{failure["testName"]} — #{failure["failureText"]}")
    end

    UI.user_error!("the test action reported 0 tests; a run that cannot fail did not pass") if total.zero?
  end

  desc "Everything CI runs"
  lane :ci do
    package
    imports
    method_docs
    bench_guard
    demo
    demo_tests
  end
end
