.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcuserdatad
*.xcresult

# Generated from Demo/project.yml by XcodeGen. Committing it would put a file that merges badly
# and drifts from the manifest into every review.
Demo/*.xcodeproj
Demo/.build-demo/
# A device build lands here: signed, unlike the simulator one, and just as regenerable.
Demo/.build-device/
# The measurement scheme's own folder, so a run's binary is not rebuilt out from under it by a
# lane that happens to share a derived data path.
Demo/.build-measure/

fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
